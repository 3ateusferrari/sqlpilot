# LLM (Claude Haiku 4.5)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_TEMPERATURE=0.0

# PostgreSQL
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/chinook
DATABASE_READONLY_URL=postgresql://sqlpilot_readonly:readonly_pass@localhost:5432/chinook
DEFAULT_ROW_LIMIT=100
MAX_VALIDATION_RETRIES=3

# Classificação de Risco & EXPLAIN
EXPLAIN_COST_THRESHOLD=500.0
EXPLAIN_ROWS_THRESHOLD=1000
ENABLE_LLM_RISK_CLASSIFIER=false

# Observabilidade (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
